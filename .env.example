# PHC-Connect Enterprise - environment config
# Local dev: copy to backend/.env (backend) and frontend/.env.local (frontend).
# On Vercel/Render: set these in the dashboard instead. NEVER commit real keys.

# ---- Backend ----
# Free key: https://aistudio.google.com/  (server-side only, never NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Any live Gemini model. Check https://ai.google.dev/gemini-api/docs/models
# (MODEL_NAME also works; the app reads either.)
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list or JSON array of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Backend base URL, no trailing slash. Baked in at build time - redeploy after changing.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: free CARTO basemap key for the outbreak map (https://carto.com/basemaps/apikey).
# Leave empty to use OpenStreetMap tiles. This value is public in the browser; restrict it to your domain in CARTO.
NEXT_PUBLIC_CARTO_KEY=
